{
  "name": "@dsh-plugin/dsh-inline-shell",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a shell command from the conversation: a prompt starting with ! executes locally and its command and output enter the same conversation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-inline-shell.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-inline-shell",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-inline-shell/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "shell",
    "inline-command"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg"
}
